{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sealed",
  "version": "1.0.0",
  "identifier": "com.sealed.sovereign",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sealed — Sovereign Intelligence Inside Your Walls",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
