# Application
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Storage & Vector Database
# Options:
# 1. Local embedded directory: QDRANT_PATH=./data/qdrant_storage
# 2. Docker Qdrant: QDRANT_URL=http://localhost:6333
QDRANT_URL=
QDRANT_PATH=./data/qdrant_storage
QDRANT_COLLECTION=local_rag_documents

# Relational Database
DATABASE_URL=sqlite+aiosqlite:///./data/ragapp.db

# Dedicated vLLM Inference Engine (Runs on port 8001)
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_TEMPERATURE=0.1
VLLM_MAX_TOKENS=2048
VLLM_TIMEOUT_SECONDS=60.0

# Quantized ONNX Models (FastEmbed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Retrieval & RRF Parameters
RETRIEVAL_TOP_K=25
RERANK_TOP_K=5
RERANK_MIN_SCORE=0.20
RRF_K=60

# Observability
ENABLE_METRICS=true
